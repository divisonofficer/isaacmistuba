{
  "schema": "class_band_reflectance_v1",
  "description": "Per physical-material NIR (854/940 nm) effective diffuse reflectance priors + spatial-transfer policy. Assigns a NEW physical property to assets that never authored NIR albedo (Infinigen base_color is RGB 3-point; NIR is an independent 4th channel and cannot be recovered from RGB). Values are LINEAR reflectance in [0,1], NOT 8-bit RGB or render brightness. See dev_report/report_2026-07-02.html (research) + 2026-07-14 discrete-band.",
  "conventions": {
    "rho_854 / rho_940": "effective diffuse reflectance at the sensor band (mean + plausible min/max spread)",
    "rgb_structure_weight": "alpha_c in rho_NIR(x)=clip[mu_c*(1+alpha_c*(L(x)/median(L)-1)),0,0.95]; 0=flat class mean, 1=full RGB spatial pattern transferred (avoid 1 -> that is NIR=f(RGB))",
    "albedo_channel": "true = diffuse reflectance is the right knob; false = band behaviour lives in Fresnel eta/k (metal) or transmission/absorption (glass), handle via optical_constants, NOT a diffuse map",
    "confidence": "high|medium|low provenance of the prior",
    "tier": "measured (own/hpBRDF) | library (external spectral) | prior (physically-reasoned distribution)"
  },
  "classes": {
