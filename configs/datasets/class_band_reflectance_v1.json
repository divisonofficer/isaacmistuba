    "painted_plastic_dark": {"rho_854": {"mean": 0.34, "min": 0.12, "max": 0.55}, "rho_940": {"mean": 0.36}, "roughness": 0.25, "albedo_channel": true, "rgb_structure_weight": 0.20, "tier": "prior", "confidence": "low", "note": "pigment-dependent; carbon-black stays dark, organic dye rises"},
