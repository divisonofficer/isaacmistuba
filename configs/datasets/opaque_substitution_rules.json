{
  "version": "robomituba-opaque-substitution-rules-v1",
  "description": "Semantic opaque-PBR substitution rules for transmissive/mirror materials. A glass/mirror material SLOT (kept geometry) is replaced by a semantically-appropriate opaque BSDF so the scene is fully describable by base_color+normal+roughness+metallic. Keyed by factory-name token first, then optical_class default. base_color_policy: 'palette' (deterministic pick by object hash), 'constant' (fixed value), 'keep_original' (reuse source base_color unless near-white).",
  "near_delta_roughness_floor": 0.10,
  "near_white_luma_threshold": 0.85,
  "target_optical_classes": ["glass", "mirror"],
  "factory_rules": {
    "JarFactory": {
      "semantic": "opaque_container",
      "bsdf": "pplastic", "metallic": 0.0, "roughness": 0.30,
      "base_color_policy": "palette", "palette": "colored_plastic",
      "reason": "유리병→불투명 플라스틱/도자기 병"
    },
    "WineglassFactory": {
      "semantic": "ceramic", "bsdf": "pplastic", "metallic": 0.0, "roughness": 0.18,
      "base_color_policy": "palette", "palette": "ceramic_offwhite",
      "reason": "유리잔→세라믹"
    },
    "CupFactory": {
      "semantic": "ceramic", "bsdf": "pplastic", "metallic": 0.0, "roughness": 0.20,
      "base_color_policy": "palette", "palette": "ceramic_offwhite",
      "reason": "유리컵→세라믹 컵"
    },
    "LargePlantContainerFactory": {
      "semantic": "ceramic", "bsdf": "pplastic", "metallic": 0.0, "roughness": 0.35,
      "base_color_policy": "palette", "palette": "terracotta",
      "reason": "유리 화병→도자기 화병"
    },
    "MicrowaveFactory": {
      "semantic": "appliance_glossy_black", "bsdf": "pplastic", "metallic": 0.0, "roughness": 0.15,
      "base_color_policy": "constant", "base_color": [0.03, 0.03, 0.03],
      "reason": "가전 유리문→glossy black 불투명 패널"
    },
    "OvenFactory": {
      "semantic": "appliance_glossy_black", "bsdf": "pplastic", "metallic": 0.0, "roughness": 0.18,
      "base_color_policy": "constant", "base_color": [0.03, 0.03, 0.03],
      "reason": "오븐 유리문→glossy black 불투명 패널"
    }
  },
  "architectural_rules": {
    "window": {
      "semantic": "opaque_dark_panel", "bsdf": "pplastic", "metallic": 0.0, "roughness": 0.30,
      "base_color_policy": "constant", "base_color": [0.05, 0.05, 0.06],
      "reason": "창→블라인드/불투명 dark 패널"
    },
    "glass_door": {
      "semantic": "painted_door", "bsdf": "pplastic", "metallic": 0.0, "roughness": 0.35,
      "base_color_policy": "palette", "palette": "painted_panel",
      "reason": "유리문→도장 문"
    },
    "glass_partition": {
      "semantic": "office_partition", "bsdf": "pplastic", "metallic": 0.0, "roughness": 0.40,
      "base_color_policy": "constant", "base_color": [0.85, 0.85, 0.85],
      "reason": "유리 파티션→사무실 파티션"
    }
  },
  "default_glass": {
    "semantic": "ceramic", "bsdf": "pplastic", "metallic": 0.0, "roughness": 0.25,
    "base_color_policy": "palette", "palette": "ceramic_offwhite",
    "reason": "generic glass prop → opaque ceramic"
  },
  "default_mirror": {
    "semantic": "brushed_metal_panel", "bsdf": "roughconductor", "metallic": 1.0, "roughness": 0.20,
    "conductor": "aluminium",
    "reason": "거울→거친 금속 패널(near-delta 방지)"
  },
  "palettes": {
    "ceramic_offwhite": [[0.82, 0.80, 0.76], [0.88, 0.86, 0.82], [0.75, 0.74, 0.71]],
    "colored_plastic": [[0.75, 0.28, 0.22], [0.22, 0.45, 0.72], [0.30, 0.55, 0.35], [0.85, 0.72, 0.30], [0.55, 0.35, 0.65]],
    "terracotta": [[0.62, 0.32, 0.20], [0.70, 0.40, 0.26]],
    "painted_panel": [[0.80, 0.80, 0.78], [0.35, 0.40, 0.45], [0.55, 0.30, 0.25]]
  },
  "material_name_overrides": {}
}
