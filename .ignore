**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
**/*.egg-info/
/build/
**/dist/
/.playwright-mcp/

# Generated render, dataset, training, and log outputs
/out/
/outputs/
/renders/
/datasets/
/checkpoints/
/logs/
